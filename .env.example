# Production / Deployment environment variables for Vercel
# Replace with your actual Render backend URL:
# Example: https://auction-backend-xxxx.onrender.com/api/v1
VITE_API_BASE_URL=https://auction-backend-xxxx.onrender.com/api/v1

# Example: https://auction-backend-xxxx.onrender.com
VITE_SOCKET_URL=https://auction-backend-xxxx.onrender.com

# --- Firebase (get these from Firebase Console → Project Settings) ---
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:placeholder
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
